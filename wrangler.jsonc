{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uplink-knowledge-base",
  "compatibility_date": "2025-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "uplink.tech/knowledge-base*",
      "zone_name": "uplink.tech"
    }
  ],
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page"
  }
}
